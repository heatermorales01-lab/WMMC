//This is your Prisma schema file,
// WM Muebles Contemporáneos ERP
//Prueba

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================
// ROLES
// =====================================
model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre    String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

// =====================================
// USUARIOS
// =====================================
model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre    String   @db.VarChar(100)
  correo    String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255)
  activo    Boolean  @default(true)
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role             Role              @relation(fields: [roleId], references: [id])
  timesheetEntries TimesheetEntry[]
  weeklySummaries  WeeklyTimesheetSummary[]
  calendarEvents   CalendarEvent[]
  wageConfig       UserWageConfig?

  @@map("users")
}

// =====================================
// CLIENTES
// =====================================
model Client {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre        String   @db.VarChar(150)
  telefono      String?  @db.VarChar(50)
  correo        String?  @db.VarChar(150)
  direccion     String?
  observaciones String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  projects Project[]

  @@map("clients")
}

// =====================================
// PROYECTOS
// =====================================
model Project {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId                 String    @map("client_id") @db.Uuid
  nombreProyecto           String    @map("nombre_proyecto") @db.VarChar(200)
  ubicacion                String?
  descripcion              String?
  estado                   String    @default("COTIZACION") @db.VarChar(50)
  fechaInstalacionTentativa DateTime? @map("fecha_instalacion_tentativa") @db.Date
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  client           Client            @relation(fields: [clientId], references: [id])
  quotations       Quotation[]
  calendarEvents   CalendarEvent[]
  projectFiles     ProjectFile[]
  paymentSchedules PaymentSchedule[]
  payments         Payment[]
  productionStages ProductionStage[]
  sale             Sale?

  @@map("projects")
}

// =====================================
// PRECIO POR MATERIAL Y TIPO DE MUEBLE
// =====================================
// Permite que BASE en Melamina tenga 185000 y en MDF tenga 235000
model MaterialFurniturePrice {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  furnitureTypeId String        @map("furniture_type_id") @db.Uuid
  materialId      String        @map("material_id") @db.Uuid
  precio          Decimal       @db.Decimal(12, 2)
  // Campos especiales para Aéreo Refri cajón especial
  precioBase210   Decimal?      @map("precio_base_210") @db.Decimal(12, 2)
  costoExtraCm    Decimal?      @map("costo_extra_cm") @db.Decimal(12, 2)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  furnitureType FurnitureType @relation(fields: [furnitureTypeId], references: [id])
  material      Material      @relation(fields: [materialId], references: [id])

  @@unique([furnitureTypeId, materialId])
  @@map("material_furniture_prices")
}

// =====================================
// TIPOS DE MUEBLE
// =====================================
model FurnitureType {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre     String   @db.VarChar(100)
  precioBase Decimal  @map("precio_base") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  quotationItems QuotationItem[]
  materialPrices MaterialFurniturePrice[]

  @@map("furniture_types")
}

// =====================================
// MATERIALES
// =====================================
model Material {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String   @db.VarChar(100)
  descripcion String?
  createdAt   DateTime @default(now()) @map("created_at")

  quotationItems QuotationItem[]
  materialPrices MaterialFurniturePrice[]

  @@map("materials")
}

// =====================================
// TIPOS DE SOBRE (ENCIMERA)
// =====================================
model CountertopType {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre    String   @db.VarChar(100)
  precioM2  Decimal  @map("precio_m2") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  quotationItems QuotationItem[]

  @@map("countertop_types")
}

// =====================================
// COTIZACIONES
// =====================================
model Quotation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  version   Int      @default(1)
  subtotal  Decimal  @default(0) @db.Decimal(14, 2)
  descuento       Decimal  @default(0) @db.Decimal(14, 2)
  descuentoMotivo String?  @map("descuento_motivo") @db.VarChar(200)
  incluirIva Boolean @default(false) @map("incluir_iva")
  ivaMonto  Decimal  @default(0) @db.Decimal(14, 2) @map("iva_monto")
  total     Decimal  @default(0) @db.Decimal(14, 2)
  estado    String   @default("BORRADOR") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project           Project            @relation(fields: [projectId], references: [id])
  quotationItems    QuotationItem[]
  quotationServices QuotationService[]
  sale              Sale?

  @@map("quotations")
}

// =====================================
// ITEMS DE COTIZACIÓN (MUEBLES)
// =====================================
model QuotationItem {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationId      String   @map("quotation_id") @db.Uuid
  furnitureTypeId  String   @map("furniture_type_id") @db.Uuid
  materialId       String   @map("material_id") @db.Uuid
  countertopTypeId String?  @map("countertop_type_id") @db.Uuid
  descripcion      String?
  nombrePersonalizado String? @map("nombre_personalizado") @db.VarChar(200)
  fondoPersonalizado  String? @map("fondo_personalizado") @db.VarChar(100)
  alto             Decimal? @db.Decimal(10, 2)
  ancho            Decimal? @db.Decimal(10, 2)
  largo            Decimal  @db.Decimal(10, 2)
  cantidad         Int      @default(1)
  precioUnitario   Decimal? @map("precio_unitario") @db.Decimal(14, 2)
  subtotal         Decimal? @db.Decimal(14, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  quotation           Quotation            @relation(fields: [quotationId], references: [id])
  furnitureType       FurnitureType        @relation(fields: [furnitureTypeId], references: [id])
  material            Material             @relation(fields: [materialId], references: [id])
  countertopType      CountertopType?      @relation(fields: [countertopTypeId], references: [id])
  quotationItemExtras QuotationItemExtra[]

  @@map("quotation_items")
}

// =====================================
// EXTRAS
// =====================================
model Extra {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre    String   @db.VarChar(100)
  precio    Decimal  @db.Decimal(12, 2)
  unidad    String?  @db.VarChar(50)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  quotationItemExtras QuotationItemExtra[]

  @@map("extras")
}

// =====================================
// EXTRAS POR ITEM DE COTIZACIÓN
// =====================================
model QuotationItemExtra {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationItemId String   @map("quotation_item_id") @db.Uuid
  extraId         String   @map("extra_id") @db.Uuid
  cantidad        Int      @default(1)
  subtotal        Decimal  @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  quotationItem QuotationItem @relation(fields: [quotationItemId], references: [id])
  extra         Extra         @relation(fields: [extraId], references: [id])

  @@map("quotation_item_extras")
}

// =====================================
// SERVICIOS
// =====================================
model Service {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre     String   @db.VarChar(100)
  precioBase Decimal  @map("precio_base") @db.Decimal(12, 2)
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  quotationServices QuotationService[]

  @@map("services")
}

// =====================================
// SERVICIOS POR COTIZACIÓN
// =====================================
model QuotationService {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationId String   @map("quotation_id") @db.Uuid
  serviceId   String   @map("service_id") @db.Uuid
  cantidad    Int      @default(1)
  montoManual Decimal? @map("monto_manual") @db.Decimal(14,2)
  subtotal    Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id])
  service   Service   @relation(fields: [serviceId], references: [id])

  @@map("quotation_services")
}

// =====================================
// VENTAS
// =====================================
model Sale {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String   @unique @map("project_id") @db.Uuid
  quotationId String   @unique @map("quotation_id") @db.Uuid
  fecha       DateTime @default(now()) @db.Date
  total       Decimal? @db.Decimal(14, 2)
  estado      String   @default("ACTIVA") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  project   Project   @relation(fields: [projectId], references: [id])
  quotation Quotation @relation(fields: [quotationId], references: [id])

  @@map("sales")
}

// =====================================
// PLAN DE PAGOS
// =====================================
model PaymentSchedule {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  descripcion   String?   @db.VarChar(150)
  porcentaje    Decimal?  @db.Decimal(5, 2)
  fechaEstimada DateTime? @map("fecha_estimada") @db.Date
  pagado        Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])

  @@map("payment_schedule")
}

// =====================================
// PAGOS
// =====================================
model Payment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  monto          Decimal  @db.Decimal(14, 2)
  metodoPago     String   @default("TRANSFERENCIA") @map("metodo_pago") @db.VarChar(50)
  comprobanteUrl String?  @map("comprobante_url")
  observaciones  String?
  fechaPago      DateTime @default(now()) @map("fecha_pago")
  createdAt      DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])
  receipt Receipt?

  @@map("payments")
}

// =====================================
// RECIBOS
// =====================================
model Receipt {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId       String   @unique @map("payment_id") @db.Uuid
  numeroRecibo    String?  @unique @map("numero_recibo") @db.VarChar(100)
  pdfUrl          String?  @map("pdf_url")
  fechaGeneracion DateTime @default(now()) @map("fecha_generacion")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("receipts")
}

// =====================================
// ETAPAS DE PRODUCCIÓN
// =====================================
model ProductionStage {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  etapa      String    @db.VarChar(100)
  estado     String    @default("PENDIENTE") @db.VarChar(50)
  fechaInicio DateTime? @map("fecha_inicio") @db.Date
  fechaFin   DateTime? @map("fecha_fin") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])

  @@map("production_stages")
}

// =====================================
// ARCHIVOS DE PROYECTO
// =====================================
model ProjectFile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  tipo         String?  @db.VarChar(50)
  nombreArchivo String? @map("nombre_archivo") @db.VarChar(255)
  urlArchivo   String   @map("url_archivo")
  fechaSubida  DateTime @default(now()) @map("fecha_subida")

  project Project @relation(fields: [projectId], references: [id])

  @@map("project_files")
}

// =====================================
// INVENTARIO
// =====================================
model InventoryItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre       String   @db.VarChar(150)
  categoria    String?  @db.VarChar(100)
  unidadMedida String?  @map("unidad_medida") @db.VarChar(50)
  stockActual  Decimal  @default(0) @map("stock_actual") @db.Decimal(14, 2)
  stockMinimo  Decimal  @default(0) @map("stock_minimo") @db.Decimal(14, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("inventory_items")
}

// =====================================
// CONTROL DE HORARIO
// Empleados y trabajadores registran entrada/salida.
// El admin ve los totales y el cálculo salarial.
// =====================================
model TimesheetEntry {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  fecha       DateTime  @db.Date
  horaEntrada DateTime  @map("hora_entrada")
  horaSalida  DateTime? @map("hora_salida")

  // Desayuno (20 min pagos)
  desayunoInicio DateTime? @map("desayuno_inicio")
  desayunoFin    DateTime? @map("desayuno_fin")
  // Almuerzo (40 min pagos)
  almuerzoInicio DateTime? @map("almuerzo_inicio")
  almuerzoFin    DateTime? @map("almuerzo_fin")
  // Café (10 min pagos)
  cafeInicio     DateTime? @map("cafe_inicio")
  cafeFin        DateTime? @map("cafe_fin")

  horasTrabajadas Decimal? @map("horas_trabajadas") @db.Decimal(5, 2)
  minutosExcedentes Int?   @map("minutos_excedentes") // tiempo de descansos que excedió lo permitido y se descontó
  observaciones   String?  @db.VarChar(255)
  archivado   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("timesheet_entries")
}

// Minutos pagos permitidos por tipo de descanso. Configurable por el admin,
// con estos valores por defecto: desayuno 20', almuerzo 40', café 10'.
model BreakPolicy {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo              String   @unique @db.VarChar(20) // DESAYUNO | ALMUERZO | CAFE
  minutosPermitidos Int      @map("minutos_permitidos")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("break_policies")
}

// Resumen semanal archivado: se genera al "cerrar" una semana desde el
// reporte de administrador. Conserva el total de horas y el salario
// calculado de forma compacta, sin necesidad de conservar cada fila
// individual de entrada/salida en la tabla operativa.
model WeeklyTimesheetSummary {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  semanaInicio  DateTime @map("semana_inicio") @db.Date
  semanaFin     DateTime @map("semana_fin") @db.Date
  totalHoras    Decimal  @map("total_horas") @db.Decimal(6, 2)
  tarifaHora    Decimal? @map("tarifa_hora") @db.Decimal(10, 2)
  salarioTotal  Decimal? @map("salario_total") @db.Decimal(12, 2)
  cantidadDias  Int      @map("cantidad_dias")
  generadoPor   String   @map("generado_por") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("weekly_timesheet_summaries")
}

// Configuración de tarifa por hora por usuario
model UserWageConfig {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  tarifaHora    Decimal  @map("tarifa_hora") @db.Decimal(10, 2)
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_wage_configs")
}

// =====================================
// AUDIENCIA DEL EVENTO
// =====================================
enum Audience {
  TODOS
  SOLO_ADMIN
  EMPLEADOS
  TRABAJADORES
}


// =====================================
// EVENTOS PERSONALIZADOS DEL CALENDARIO
// Visitas de medición, reuniones, visitas al taller, etc.
// Cualquier usuario puede crear eventos; el admin puede ver todos.
// =====================================
model CalendarEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo      String   @db.VarChar(200)
  descripcion String?  @db.VarChar(500)
  fecha       DateTime @db.Date
  tipo        String   @db.VarChar(50)  // MEDICION | TALLER | REUNION | OTRO
  audiencia Audience @default(TODOS)
  projectId   String?  @map("project_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project   Project? @relation(fields: [projectId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@map("calendar_events")
}